# ============================================
#  Configuracion de Base de Datos (Supabase Postgres)
#  Estos valores son de ejemplo. En produccion usa
#  variables de entorno: DB_HOST, DB_PORT, DB_NAME,
#  DB_USER, DB_PASSWORD (tienen prioridad sobre este archivo)
#
#  IMPORTANTE: usa el host y usuario del "Session pooler"
#  de Supabase (Connect -> Session pooler), NO los de
#  "Direct connection". El host directo solo responde por
#  IPv6 y en la mayoria de hostings gratuitos la conexion
#  falla. El pooler funciona por IPv4 y el usuario lleva un
#  punto: postgres.<id-de-tu-proyecto>
# ============================================
db.host=aws-0-us-east-1.pooler.supabase.com
db.port=5432
db.name=postgres
db.user=postgres.xxxxxxxxxxxxxxxxxxxx
db.password=CAMBIA_ESTA_CLAVE

# ============================================
#  Configuracion de Supabase Storage
#  Variables de entorno equivalentes: SUPABASE_URL,
#  SUPABASE_KEY, SUPABASE_BUCKET
# ============================================
supabase.url=https://xxxxxxxxxxxxxxxx.supabase.co
supabase.key=CAMBIA_ESTA_SERVICE_ROLE_KEY
supabase.bucket=portafolio-archivos
